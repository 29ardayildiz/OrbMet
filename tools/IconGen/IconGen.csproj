<Project Sdk="Microsoft.NET.Sdk">

  <!-- Writes src/OrbMet.Desktop/Assets/OrbMet.ico. Not part of OrbMet.slnx;
       run it by hand when the icon changes, from the repository root:
       dotnet run (project tools/IconGen) with the output path as argument.
       The exact command is in design.md 3. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>

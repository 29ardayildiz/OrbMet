<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OrbMet.Core\OrbMet.Core.csproj" />
    <ProjectReference Include="..\OrbMet.Capture\OrbMet.Capture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Provider marks, licensed in THIRD_PARTY_NOTICES.md. -->
  <ItemGroup>
    <Resource Include="Assets\Marks\*.svg" />
  </ItemGroup>

  <!-- The app's own mark, made by tools/IconGen: the exe and windows use it
       through ApplicationIcon, the tray loads it as a resource. -->
  <ItemGroup>
    <Resource Include="Assets\OrbMet.ico" />
  </ItemGroup>

  <!-- WinForms is on only for the tray icon. Its implicit usings would collide
       with WPF's Application/MessageBox, so they are removed here and imported
       explicitly where needed. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\OrbMet.ico</ApplicationIcon>
    <!-- The file people start is OrbMet.exe; resource URIs use this name. -->
    <AssemblyName>OrbMet</AssemblyName>
    <Product>OrbMet</Product>
  </PropertyGroup>

  <!-- Keep the capture helper beside the app so the same relative lookup works
       in development and in a folder publish. Packaging layout is settled in
       stage 4. -->
  <Target Name="CopyCaptureHelper" AfterTargets="Build">
    <ItemGroup>
      <CaptureHelperFiles Include="$(MSBuildThisFileDirectory)..\OrbMet.Capture\bin\$(Configuration)\net10.0\OrbMet.Capture.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CaptureHelperFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>

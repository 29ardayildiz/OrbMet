<Window x:Class="OrbMet.Desktop.DetailCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OrbMet.Desktop.Controls"
        xmlns:infra="clr-namespace:OrbMet.Desktop.Infrastructure"
        Title="OrbMet ayrıntı"
        Width="{x:Static infra:PanelMetrics.CardWindowWidth}"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <!-- Body and tail as one outline; rebuilt when the size or the tail's target changes. -->
        <Path x:Name="Bubble" Fill="Black" />

        <ScrollViewer x:Name="Scroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <controls:ProviderDetails x:Name="Body" />
        </ScrollViewer>
    </Grid>
</Window>

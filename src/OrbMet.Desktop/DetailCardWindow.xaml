<Window x:Class="OrbMet.Desktop.DetailCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OrbMet.Desktop.Controls"
        xmlns:infra="clr-namespace:OrbMet.Desktop.Infrastructure"
        Title="OrbMet ayrıntı"
        Width="{x:Static infra:PanelMetrics.CardWidth}"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <!-- A card standing apart from the strip, no tail (design.md 7.1). -->
    <Border Background="Black" CornerRadius="{x:Static infra:PanelMetrics.CardCornerRadiusValue}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <controls:ProviderDetails x:Name="Body" />
        </ScrollViewer>
    </Border>
</Window>

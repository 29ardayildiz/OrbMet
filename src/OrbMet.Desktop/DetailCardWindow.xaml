<Window x:Class="OrbMet.Desktop.DetailCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OrbMet.Desktop.Controls"
        xmlns:infra="clr-namespace:OrbMet.Desktop.Infrastructure"
        Title="OrbMet ayrıntı"
        Width="{x:Static infra:PanelMetrics.CardWidth}"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B6BDCA" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Setter Property="Foreground" Value="#929BAA" />
        </Style>

        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Foreground" Value="#15171C" />
            <Setter Property="Background" Value="#B6B0FF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1D2027"
            BorderBrush="#343945"
            BorderThickness="1"
            CornerRadius="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,14,16,16">

                <!-- 1. Provider and connection state -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DisplayName}"
                               Foreground="#F4F6FA"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <Button Grid.Column="1"
                            Content="✕"
                            ToolTip="Kartı kapat"
                            AutomationProperties.Name="Kartı kapat"
                            Click="OnCloseClick"
                            Foreground="#929BAA"
                            Background="Transparent"
                            FontSize="11"
                            Padding="6,2"
                            Margin="8,-2,-6,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource CardButton}" />
                </Grid>
                <TextBlock Text="{Binding StatusText}" Margin="0,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStale}" Value="True">
                                    <Setter Property="Foreground" Value="#F3C56B" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 2. Plan, only when reported -->
                <TextBlock Text="{Binding PlanText}" Margin="0,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PlanText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 3. Every reported window -->
                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,12,0,0"
                                        AutomationProperties.Name="{Binding AccessibleText}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="#F4F6FA"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Background="#2A2E38"
                                                CornerRadius="6"
                                                Padding="6,0"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                ToolTip="Şeritteki halka bu dönemi gösteriyor"
                                                Visibility="{Binding IsRingWindow, Converter={StaticResource Visible}}">
                                            <TextBlock Text="halkada" Foreground="#B6B0FF" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding PercentText}"
                                               Foreground="#F4F6FA"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="8,0,0,0" />
                                </Grid>
                                <controls:UsageBar Height="6"
                                                   Margin="0,6,0,0"
                                                   Percent="{Binding Percent}"
                                                   IsExhausted="{Binding IsExhausted}">
                                    <controls:UsageBar.Style>
                                        <Style TargetType="controls:UsageBar">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:UsageBar.Style>
                                </controls:UsageBar>
                                <TextBlock Text="{Binding ResetText}"
                                           Style="{StaticResource SecondaryText}"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 4. Observation time and how it refreshes -->
                <TextBlock Text="{Binding ObservedText}"
                           Style="{StaticResource MutedText}"
                           Margin="0,14,0,0" />
                <TextBlock Text="{Binding HintText}"
                           Style="{StaticResource MutedText}"
                           Margin="0,2,0,0" />

                <!-- 5. One fitting action -->
                <Button Content="Yenile"
                        Click="OnRefreshClick"
                        Margin="0,12,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CardButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NeedsConnectionCheck}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Bağlantıyı kontrol et"
                        Click="OnConnectionsClick"
                        Margin="0,12,0,0"
                        Style="{StaticResource CardButton}"
                        Visibility="{Binding NeedsConnectionCheck, Converter={StaticResource Visible}}" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>

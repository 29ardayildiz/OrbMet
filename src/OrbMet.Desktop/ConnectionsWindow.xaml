<Window x:Class="OrbMet.Desktop.ConnectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OrbMet.Desktop.Controls"
        xmlns:infra="clr-namespace:OrbMet.Desktop.Infrastructure"
        Title="OrbMet Bağlantılar"
        infra:OrbMetFrame.Caption="Bağlantılar"
        Style="{StaticResource OrbMetWindow}"
        Width="360"
        SizeToContent="Height"
        PreviewKeyDown="OnPreviewKeyDown">
    <!-- design.md 10: one hairline box per provider, in the menus' language.
         Every neutral is white at an opacity; colour stays for usage. -->
    <Window.Resources>
        <Style x:Key="ProviderBox" TargetType="Border">
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="ProviderName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Status" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style x:Key="Detail" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8CFFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Plan" TargetType="TextBlock" BasedOn="{StaticResource Detail}">
            <Setter Property="Foreground" Value="#73FFFFFF" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="Footnote" TargetType="TextBlock" BasedOn="{StaticResource Detail}">
            <Setter Property="Foreground" Value="#66FFFFFF" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="14,2,14,14">
        <Border Style="{StaticResource ProviderBox}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <controls:ProviderMark Width="16" Height="16" Mark="claude" Fill="White" />
                    <TextBlock Text="Claude Code" Style="{StaticResource ProviderName}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Status}" />
                <TextBlock Text="{Binding DetailText}" Style="{StaticResource Detail}" />
                <TextBlock x:Name="ClaudePlan"
                           Text="{Binding PlanText, TargetNullValue=''}"
                           Style="{StaticResource Plan}" />
                <TextBlock Text="{Binding SettingsFootnote, TargetNullValue=''}"
                           Style="{StaticResource Footnote}" />

                <Grid Margin="0,14,0,0" HorizontalAlignment="Left">
                    <Button Content="Bağla"
                            Tag="&#xE71B;"
                            Command="{Binding ToggleCommand}"
                            AutomationProperties.Name="Claude Code'u bağla">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Ayır"
                            Tag="&#xE711;"
                            Command="{Binding ToggleCommand}"
                            AutomationProperties.Name="Claude Code bağlantısını kaldır">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Codex uses its own sign-in; there is nothing to connect, only its state and plan. -->
        <Border x:Name="CodexCard"
                Style="{StaticResource ProviderBox}"
                Margin="0,10,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <controls:ProviderMark Width="16" Height="16" Mark="openai" Fill="White" />
                    <TextBlock Text="Codex" Style="{StaticResource ProviderName}" />
                </StackPanel>
                <TextBlock Text="{Binding Message, TargetNullValue='Bağlı'}" Style="{StaticResource Status}" />
                <TextBlock Text="Codex'in kendi oturumu kullanılır; ayrıca bağlamak gerekmez."
                           Style="{StaticResource Detail}" />
                <TextBlock Text="{Binding PlanText, TargetNullValue=''}"
                           Style="{StaticResource Plan}" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>

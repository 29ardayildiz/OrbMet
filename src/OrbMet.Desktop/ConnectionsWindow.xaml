<Window x:Class="OrbMet.Desktop.ConnectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OrbMet.Desktop.Controls"
        xmlns:infra="clr-namespace:OrbMet.Desktop.Infrastructure"
        Title="{Binding [ConnectionsTitle], Source={x:Static infra:Localizer.Instance}}"
        infra:OrbMetFrame.Caption="{Binding [Connections], Source={x:Static infra:Localizer.Instance}}"
        Style="{StaticResource OrbMetWindow}"
        Width="360"
        SizeToContent="Height"
        PreviewKeyDown="OnPreviewKeyDown">
    <!-- design.md 10: one hairline box per provider, in the menus' language.
         Every neutral is white at an opacity; colour stays for usage. -->
    <Window.Resources>
        <Style x:Key="ProviderBox" TargetType="Border">
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="ProviderName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Status" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style x:Key="Detail" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8CFFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Plan" TargetType="TextBlock" BasedOn="{StaticResource Detail}">
            <Setter Property="Foreground" Value="#73FFFFFF" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="Footnote" TargetType="TextBlock" BasedOn="{StaticResource Detail}">
            <Setter Property="Foreground" Value="#66FFFFFF" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="14,2,14,14">
        <Border Style="{StaticResource ProviderBox}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <controls:ProviderMark Width="16" Height="16" Mark="claude" Fill="White" />
                    <TextBlock Text="Claude Code" Style="{StaticResource ProviderName}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Status}" />
                <TextBlock Text="{Binding DetailText}" Style="{StaticResource Detail}" />
                <TextBlock x:Name="ClaudePlan"
                           Text="{Binding PlanText, TargetNullValue=''}"
                           Style="{StaticResource Plan}" />
                <TextBlock Text="{Binding SettingsFootnote, TargetNullValue=''}"
                           Style="{StaticResource Footnote}" />

                <!-- Not connected: Connect. Connected here: Disconnect. Connected to
                     another copy's helper: Reconnect, then Disconnect. -->
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="{Binding [Reconnect], Source={x:Static infra:Localizer.Instance}}"
                            Tag="&#xE71B;"
                            Command="{Binding ReconnectCommand}"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="{Binding [ReconnectClaude], Source={x:Static infra:Localizer.Instance}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NeedsReconnect}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{Binding [Connect], Source={x:Static infra:Localizer.Instance}}"
                            Tag="&#xE71B;"
                            Command="{Binding ToggleCommand}"
                            AutomationProperties.Name="{Binding [ConnectClaude], Source={x:Static infra:Localizer.Instance}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{Binding [Disconnect], Source={x:Static infra:Localizer.Instance}}"
                            Tag="&#xE711;"
                            Command="{Binding ToggleCommand}"
                            AutomationProperties.Name="{Binding [DisconnectClaude], Source={x:Static infra:Localizer.Instance}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Codex uses its own sign-in; there is nothing to connect, only its state and plan. -->
        <Border x:Name="CodexCard"
                Style="{StaticResource ProviderBox}"
                Margin="0,10,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <controls:ProviderMark Width="16" Height="16" Mark="openai" Fill="White" />
                    <TextBlock Text="Codex" Style="{StaticResource ProviderName}" />
                </StackPanel>
                <!-- The card's message when there is one, otherwise just Connected. -->
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Status}">
                            <Setter Property="Text" Value="{Binding Message}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Message}" Value="{x:Null}">
                                    <Setter Property="Text" Value="{Binding [Connected], Source={x:Static infra:Localizer.Instance}}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding [CodexOwnSignIn], Source={x:Static infra:Localizer.Instance}}"
                           Style="{StaticResource Detail}" />
                <TextBlock Text="{Binding PlanText, TargetNullValue=''}"
                           Style="{StaticResource Plan}" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>

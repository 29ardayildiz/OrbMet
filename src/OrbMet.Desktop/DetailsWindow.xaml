<Window x:Class="OrbMet.Desktop.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OrbMet.Desktop.Controls"
        Title="OrbMet ayrıntılar"
        Width="320"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnPreviewKeyDown">
    <!-- The keyboard path to the hover card's content (design.md 10): it takes
         focus, Tab walks the rows, Escape closes. -->
    <ItemsControl x:Name="Providers"
                  Margin="18,18,18,4"
                  Focusable="False"
                  KeyboardNavigation.TabNavigation="Cycle">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <controls:ProviderDetails IsKeyboardReachable="True"
                                          Margin="0,0,0,22" />
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Window>

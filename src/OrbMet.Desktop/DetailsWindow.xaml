<Window x:Class="OrbMet.Desktop.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OrbMet.Desktop.Controls"
        xmlns:infra="clr-namespace:OrbMet.Desktop.Infrastructure"
        Title="{Binding [DetailsTitle], Source={x:Static infra:Localizer.Instance}}"
        infra:OrbMetFrame.Caption="{Binding [Details], Source={x:Static infra:Localizer.Instance}}"
        Style="{StaticResource OrbMetWindow}"
        Width="320"
        SizeToContent="Height"
        PreviewKeyDown="OnPreviewKeyDown">
    <!-- The keyboard path to the hover card's content (design.md 10): it takes
         focus, Tab walks the rows, Escape closes. -->
    <ItemsControl x:Name="Providers"
                  Margin="18,6,18,4"
                  Focusable="False"
                  KeyboardNavigation.TabNavigation="Cycle">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <controls:ProviderDetails IsKeyboardReachable="True"
                                          Margin="0,0,0,22" />
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Window>

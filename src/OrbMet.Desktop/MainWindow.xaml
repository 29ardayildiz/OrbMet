<Window x:Class="OrbMet.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:OrbMet.Desktop.Controls"
        xmlns:infra="clr-namespace:OrbMet.Desktop.Infrastructure"
        mc:Ignorable="d"
        Title="OrbMet"
        Width="{x:Static infra:PanelMetrics.StripWidth}"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <!-- 8 DIP padding plus each slot's 4 DIP margin gives the 12 DIP outer
         spacing and the 8 DIP gap between slots from design.md. -->
    <Border Background="#15171C"
            BorderBrush="#343945"
            BorderThickness="1"
            CornerRadius="22"
            Padding="0,8">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Yenile"
                          Command="{Binding RefreshCommand}" />
                <MenuItem Header="Bağlantılar"
                          Click="OnConnectionsClick" />
                <MenuItem Header="Paneli gizle"
                          Click="OnHideClick" />
                <Separator />
                <MenuItem Header="{Binding LastUpdatedText}"
                          IsEnabled="False" />
            </ContextMenu>
        </Border.ContextMenu>

        <ItemsControl ItemsSource="{Binding Providers}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Height="{x:Static infra:PanelMetrics.SlotHeight}"
                                Margin="0,4"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                ToolTip="{Binding ToolTipText}"
                                AutomationProperties.Name="{Binding AccessibleText}">
                        <controls:UsageRing Width="{x:Static infra:PanelMetrics.RingDiameter}"
                                            Height="{x:Static infra:PanelMetrics.RingDiameter}"
                                            Margin="0,5,0,0"
                                            HorizontalAlignment="Center"
                                            Percent="{Binding RingPercent}"
                                            IsExhausted="{Binding IsExhausted}"
                                            Glyph="{Binding Glyph}" />
                        <TextBlock Text="{Binding PercentText}"
                                   Foreground="#F4F6FA"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>

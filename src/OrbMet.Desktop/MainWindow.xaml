<Window x:Class="OrbMet.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:infra="clr-namespace:OrbMet.Desktop.Infrastructure"
        mc:Ignorable="d"
        Title="OrbMet"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <!-- No background on the grid: only the drawn outline and the slots take
         the pointer, so the corners outside the shape click through. -->
    <Grid x:Name="Root"
          PreviewMouseLeftButtonDown="OnPress"
          MouseMove="OnPointerMove"
          MouseLeftButtonUp="OnRelease"
          LostMouseCapture="OnLostCapture">
        <Grid.ContextMenu>
            <ContextMenu x:Name="StripMenu">
                <!-- Glyphs: Segoe Fluent Icons Refresh, Link, Hide (Themes/Menus.xaml).
                     The language submenu goes in after Hide, from code. -->
                <MenuItem Header="{Binding [Refresh], Source={x:Static infra:Localizer.Instance}}"
                          Icon="&#xE72C;"
                          Command="{Binding RefreshCommand}" />
                <MenuItem Header="{Binding [Connections], Source={x:Static infra:Localizer.Instance}}"
                          Icon="&#xE71B;"
                          Click="OnConnectionsClick" />
                <MenuItem Header="{Binding [HidePanel], Source={x:Static infra:Localizer.Instance}}"
                          Icon="&#xED1A;"
                          Click="OnHideClick" />
                <Separator />
                <MenuItem Header="{Binding LastUpdatedText}"
                          IsEnabled="False" />
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- The outline for the current dock: a capsule, or an L in a corner
             (design.md 4.2). Set in code with the slots' frames. -->
        <Path x:Name="Outline" Fill="Black" />

        <!-- One SlotView per provider, positioned from the outline's plan. -->
        <Canvas x:Name="SlotLayer" />
    </Grid>
</Window>
